# --- Clé API Mistral ---
MISTRAL_API_KEY=""

# --- Observabilité Pydantic Logfire ---
# Créez un projet sur https://logfire.pydantic.dev puis collez le token ici.
LOGFIRE_TOKEN=""
# Mettre à "true" pour désactiver l'envoi des traces (utile en CI / offline)
LOGFIRE_DISABLE=false

# --- Base de données SQL (Étape 2) ---
# PostgreSQL est la base de données cible du projet (cf. consignes). Deux options :
#   1) PostgreSQL local (installé sur votre machine, port par défaut 5432) :
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/sportsee"
#   2) PostgreSQL hébergé gratuitement (aucune install locale requise), par ex.
#      Neon (https://neon.tech) ou Supabase (https://supabase.com) : copiez
#      l'URI de connexion fournie par le service, sous la forme :
#      DATABASE_URL="postgresql+psycopg2://user:password@host:5432/dbname"
#
# Dépannage / démo hors-ligne sans serveur PostgreSQL : SQLite reste supporté
# par le code sans aucune modification, il suffit de définir :
# DATABASE_URL="sqlite:///database/sportsee.db"

# --- Téléchargement optionnel des données sources ---
# INPUT_DATA_URL=""

# --- OCR (Nanonets/Docstrange) — fallback pour les PDF scannés (rapports en image) ---
# Compte gratuit : https://docstrange.nanonets.com (clé dans le menu en haut
# à droite une fois connecté — PAS la clé de l'ancienne page
# app.nanonets.com/#/keys, incompatible avec l'API actuelle).
# Sans clé, l'OCR est simplement désactivé (extraction PDF standard uniquement,
# aucun crash).
NANONETS_API_KEY=""
